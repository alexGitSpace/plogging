<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Plogging Glasses</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- The Meta AI app calls the app back through this link scheme. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ploggingglasses</string>
			</array>
		</dict>
	</array>

	<!-- Meta Wearables Device Access Toolkit. -->
	<key>MWDAT</key>
	<dict>
		<!-- Must match the link scheme above. -->
		<key>AppLinkURLScheme</key>
		<string>ploggingglasses://</string>
		<!-- Empty in Developer Mode. For a release channel, set META_APP_ID and CLIENT_TOKEN
		     as build settings outside git, from the Wearables Developer Center. -->
		<key>MetaAppID</key>
		<string>$(META_APP_ID)</string>
		<key>ClientToken</key>
		<string>$(CLIENT_TOKEN)</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
		<!-- Do not send usage analytics to Meta. -->
		<key>Analytics</key>
		<dict>
			<key>OptOut</key>
			<true/>
		</dict>
	</dict>

	<!-- The links to the glasses: Bluetooth LE, Bluetooth Classic (camera), Wi-Fi. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Needed to connect to the Meta glasses.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lets the phone find and connect to the glasses over Wi-Fi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>

	<!-- Only for the "Simulated glasses: phone camera" source. -->
	<key>NSCameraUsageDescription</key>
	<string>Shows the phone camera to the litter detector in place of the glasses.</string>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
